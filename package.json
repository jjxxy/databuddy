{
  "name": "nexus-databuddy-desktop",
  "version": "0.20.0",
  "private": true,
  "description": "Nexus WorkStudio portable local desktop",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "ui:build": "vite build --config ui/vite.config.mjs",
    "ui:build-web-dag": "vite build --config ui/web-dag.vite.config.mjs",
    "desktop:test": "node --test desktop/tests/*.test.cjs",
    "desktop:build": "npm run ui:build && npm run ui:build-web-dag && npm run ui:build-docx && npm run ui:build-pptx && node packaging/build-desktop.mjs",
    "ui:build-docx": "vite build --config ui/docx-sandbox.vite.config.mjs",
    "ui:build-pptx": "vite build --config ui/pptx-sandbox.vite.config.mjs"
  },
  "dependencies": {
    "@office-kit/pptx": "0.28.0",
    "@office-kit/pptx-preview": "0.21.0",
    "@xyflow/react": "12.12.0",
    "docx-preview": "0.4.1",
    "jszip": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "vite": "8.3.5"
  }
}
