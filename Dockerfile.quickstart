FROM node:22-bookworm-slim AS node
FROM python:3.12.14-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git libpq5 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 atlas && useradd -u 10001 -g 10001 -m atlas
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock
COPY deploy/install_opencode.py /tmp/install_opencode.py
RUN python /tmp/install_opencode.py && rm /tmp/install_opencode.py
COPY . /app
ENV DATA_DIR=/data PORT=8000 ATLAS_DROP_PRIVILEGES=1 PYTHONUNBUFFERED=1 \
    AGENT_ORCHESTRATION_MODE=separate SCHEDULER_MODE=worker ATLAS_OPENCODE_RUNTIME=1
EXPOSE 8000
CMD ["python", "-m", "agent_service.cloud"]
